# ============================================================
#  tg-service — конфигурация
#  Скопируйте в .env и заполните. Файл .env в git не попадает.
# ============================================================

# --- Telegram: обязательно ----------------------------------
# Получить на https://my.telegram.org/apps (раздел API development tools)
TG_API_ID=
TG_API_HASH=

# Файл сессии. Создаётся командой `uv run tg-login`.
# ВНИМАНИЕ: этот файл равен полному доступу к вашему аккаунту. Не копировать, не коммитить.
TG_SESSION=data/user.session

# Прокси, если Telegram недоступен напрямую (socks5 / socks4 / http).
# Через него же ходит запрос к OpenRouter. Пусто = напрямую.
# Пример: socks5://127.0.0.1:1080
TG_PROXY=

# --- База данных: обязательно -------------------------------
# Поднимается через `docker compose up -d db`
DATABASE_URL=postgresql://tg:tg@127.0.0.1:5436/tg

# --- HTTP API: обязательно ----------------------------------
# Слушает только localhost. Наружу не выставлять: это доступ ко всей вашей переписке.
API_HOST=127.0.0.1
API_PORT=8077
# Придумайте длинную случайную строку:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
API_TOKEN=change-me

# --- Сбор истории -------------------------------------------
INITIAL_HISTORY=200          # сколько сообщений подтянуть из каждого чата при первом запуске
CATCHUP_LIMIT=2000           # максимум сообщений на чат, чтобы закрыть пропуск после перезапуска
BACKFILL_BATCH=200           # размер пачки при загрузке истории
FLOOD_SLEEP_THRESHOLD=600    # до скольких секунд ожидания Telethon терпит сам

# --- MCP-сервер (обращается к API) --------------------------
TG_API_URL=http://127.0.0.1:8077

# ============================================================
#  Медиа: скачивание, расшифровка, распознавание
# ============================================================
MEDIA_DIR=data/media
MEDIA_RETENTION_DAYS=30           # через сколько дней удалять скачанные файлы (текст остаётся)

MEDIA_AUTO_TRANSCRIBE=true        # голосовые и кружки -> текст автоматически
MEDIA_AUTO_EXTRACT=true           # документы -> текст автоматически
MEDIA_AUTO_EXTRACT_MAX_MB=20      # документы крупнее не трогаем
MEDIA_AUTO_DESCRIBE=true          # фото -> описание + OCR автоматически

# Автоматика работает только в личках и группах. Каналы, видео и крупные файлы —
# только по явному запросу агента.

# --- Распознавание речи -------------------------------------
# macOS (Apple Silicon): mlx-community/whisper-large-v3-turbo — быстро и точно.
# Linux / VPS без GPU: смотрите docs/BUILD_GUIDE.md, раздел про Whisper.
WHISPER_MODEL=mlx-community/whisper-large-v3-turbo
WHISPER_LANGUAGE=                 # пусто = определять автоматически; можно указать ru

MEDIA_MODEL_IDLE=300              # через сколько секунд простоя выгрузить модели из памяти
MEDIA_WORKER_PORT=8078            # локальный HTTP медиа-воркера

# --- Картинки: описание и OCR -------------------------------
# Ключ с https://openrouter.ai. Без него всё остальное работает, картинки просто не распознаются.
# Цена порядка $0.0005 за изображение.
OPENROUTER_API_KEY=
VISION_MODEL=minimax/minimax-m3
VISION_PDF_PAGES=3                # сколько страниц скана PDF отправлять в модель

# --- Семантический поиск ------------------------------------
# Модель работает локально, переписка наружу не уходит.
EMBED_ENABLED=true
EMBED_MODEL=intfloat/multilingual-e5-small
EMBED_CHANNELS=true               # индексировать ли посты каналов

# ============================================================
#  Отправка сообщений: только с вашего подтверждения
# ============================================================
SEND_ENABLED=true

# Бот, который присылает карточки с кнопками и ежедневную сводку.
# Создать: @BotFather -> /newbot. Без токена карточки придут от вашего же аккаунта, но без кнопок.
BOT_TOKEN=

# Куда слать карточки на подтверждение.
#   me           = Избранное (кнопки работать не будут, только текстом ok/no)
#   -1001234567  = id вашей приватной группы (рекомендуется: приходят уведомления и кнопки)
#   @username    = тоже можно
# Бота в группу сервис добавит сам при старте.
OUTBOX_CHAT=me

SEND_DRAFT_TTL_MINUTES=10         # сколько живёт неподтверждённый черновик
SEND_MAX_CHARS=4000               # максимальная длина сообщения
SEND_RATE_PER_HOUR=0              # 0 = без ограничения
SEND_RATE_PER_CHAT_PER_HOUR=0     # 0 = без ограничения
SEND_MAX_FILE_MB=2000             # максимальный размер вложения
SEND_MAX_ATTACHMENTS=10           # сколько файлов можно приложить к одному сообщению

# Папки, откуда агенту разрешено брать файлы для отправки (через запятую).
# Папка MEDIA_DIR разрешена всегда. Всё остальное будет отклонено.
SEND_FILE_ROOTS=

# --- Мониторинг ---------------------------------------------
HEALTH_INTERVAL=300               # как часто проверять себя, секунд. 0 = выключить
HEALTH_QUIET_HOURS=01:00-08:00    # когда не будить алертами о тишине в чатах
DIGEST_TIME=21:00                 # время ежедневной сводки. Пусто = выключить

LOG_LEVEL=INFO
